    },
    {
      "id": "openness", "negName": "拒之門外", "posName": "來者不拒", "weight": 0.65,
      "desc": "陸資、陸生、陸配與對岸企業要開放到什麼程度。這是最容易被個案新聞牽動的一項，一起社會事件就能翻轉幾個百分點。"
    },
    {
      "id": "usTrust", "negName": "疑美主義", "posName": "堅信盟友", "weight": 0.75,
      "desc": "美國到底會不會來，以及來了以後台灣要付出什麼。疑美情緒在近年快速上升，而且藍綠兩邊都有。"
    },
    {
      "id": "japanTrust", "negName": "舊恨難消", "posName": "唇齒相依", "weight": 0.4,
      "desc": "對日本的信賴與情感。它同時牽動安全期待、觀光消費與歷史記憶，世代差異在這一項上最為明顯。"
    }
