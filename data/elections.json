  "subsidy": {
    "_note": [
      "選舉補助款。依《公職人員選舉罷免法》第四十三條與《總統副總統選舉罷免法》第四十一條：",
      "候選人得票數達該選區當選票數三分之一以上者，每票補助新臺幣三十元。",
      "注意門檻不是得票率，是「當選人票數的三分之一」——",
      "所以在一個五席的議員選區裡，這個門檻比想像中低很多；在單一席次的選區裡則高得多。",
      "",
      "政黨補助是另一筆：政黨票得票率達百分之三以上者，每票每年補助五十元，發給政黨而不是個人。",
      "",
      "然後是台灣政治裡大家知道但不會寫在法條上的那一段：",
      "政黨會從當選人的補助款裡抽一筆。名目可能叫回饋金、常年黨費或黨務發展基金，",
      "比例各黨不同，紀律越嚴的黨抽得越兇。無黨籍不用抽，代價是也沒有人替你扛。"
    ],
    "perVote": 30,
    "winnerRatio": 0.3334,
    "partyPerVote": 50,
    "partyVoteThreshold": 0.03,
    "partyCut": {
      "_note": "各黨從當選人補助款裡抽走的比例。紀律越嚴、組織越大的黨抽得越兇。",
      "PDA": 0.2,
      "CRP": 0.18,
      "TPL": 0.25,
      "NGF": 0.3,
      "TWR": 0.28,
      "GSP": 0.25,
      "CUA": 0.22,
      "default": 0.2
    },
    "noSubsidyLevels": [
      "villageHead",
      "townshipRep"
    ],
    "noSubsidyNote": "村里長與鄉鎮市民代表這一級沒有中央的競選費用補助款，各地方自治條例規定不一，多數是沒有。",
    "text": {
      "got": "中選會今天核撥競選費用補助款：{votes} 票乘上每票三十元，總共 {gross}。",
      "cut": "黨中央依照黨內規定抽走了 {rate}（{cut}），名目寫的是黨務發展基金。你收到的是 {net}。",
      "clean": "你沒有黨籍，這筆錢一塊都不用分出去。這是無黨籍少數幾件划算的事情之一。",
      "missed": "你的票數沒有達到當選票數的三分之一，這一場沒有補助款。文宣、看板與便當的錢就是這樣沒有了。",
      "none": "這個層級沒有中央的競選費用補助款。跑一整年的成本全部是自己的。"
    }
  },
  "sameDay": {
    "_note": [
      "同一天開的其他選舉。",
      "台灣的選舉是綁在一起投的：地方選舉那一天，你手上會拿到縣市長、議員、",
      "鄉鎮市長、村里長好幾張票；中央選舉那一天則是總統、區域立委、政黨票。",
      "",
      "重點不是把它們列出來好看，是**下層級的結果很大程度取決於上層級**。",
      "台灣人管這個叫母雞帶小雞：縣市長選情好的那一邊，議員會多上幾席；",
      "總統大勝的那一年，立委席次會跟著翻過去。",
      "所以開票畫面要一起看，因為玩家那一場的勝負本來就有一部分不是他決定的。"
    ],
    "ticketOrder": [
      "president",
      "mayor",
      "legislator",
      "partyList",
      "councilor",
      "townshipHead",
      "townshipRep",
      "villageHead"
    ],
    "coattail": {
      "_note": [
        "上層級的得票差距會有多少比例傳導到下層級。",
        "數字是「上層級贏家的領先幅度 × 這個係數」，加到下層級同黨候選人的得票上。",
        "政黨票跟著總統跑得最兇（0.75），因為那根本是同一張選票上的同一個判斷；",
        "村里長幾乎不受影響（0.12），因為那一票投的是隔壁的鄰居，不是政黨。"
      ],
      "president": {
        "legislator": 0.95,
        "partyList": 1.15,
        "councilor": 0.5
      },
      "mayor": {
        "councilor": 0.8,
        "townshipHead": 0.55,
        "townshipRep": 0.4,
        "villageHead": 0.2
      },
      "maxShift": 0.16
    },
    "text": {
      "header": "同一天開出來的其他票",
      "coattailStrong": "{top}那一場贏得很大，那個氣勢一路帶下來，同一張選票上的下面幾格也跟著翻過去。這件事在台灣叫母雞帶小雞。",
      "coattailWeak": "{top}那一場咬得很緊，下面幾格就各憑本事——沒有人帶得動誰。",
      "coattailAgainst": "{top}那一場輸掉了，下面幾格的自己人全部被拖著走。有人在檢討會上說這不是他們的問題，那句話沒有人接。",
      "playerLifted": "你這一席有一部分不是你自己贏來的。{party}在{top}那一場的氣勢把你抬過了那條線，這件事你心裡有數。",
      "playerDragged": "你自己的部分做得不差，但{party}在{top}那一場輸得太難看，你被那個結果一起拖下去了。"
    }
  },
  "partyAssess": {
    "_note": [
      "黨中央的選區評估。",
      "選前黨部會把全部的選區分級，然後把錢跟人往「打得下來」的地方倒。",
      "這件事的邏輯很冷：穩贏的不用給，穩輸的給了也是丟到水裡，",
      "**只有五五波的地方值得投資**——而且席次越少，投資的邊際效益越高，",
      "因為單一席次選區贏一票就全拿，複數選區多一點票只是名次往前挪。",
      "",
      "所以一個在艱困選區苦撐的人，會發現黨中央的資源永遠到不了他手上；",
      "而一個在五五波選區的人，會突然發現有人主動打電話來問他缺什麼。",
      "這不是誰對誰錯，是資源分配本來就長這樣。"
    ],
    "tiers": [
      {
        "id": "MUST_WIN",
        "name": "必爭之地",
        "min": 0.44,
        "max": 0.56,
        "resource": 1.0,
